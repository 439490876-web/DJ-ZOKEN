NETEASE_API_BASE_URL=http://127.0.0.1:3001
# NETEASE_API_FALLBACK_URL=https://your-stable-public-api.example.com
NETEASE_API_TIMEOUT_SEC=8
HEAT_ENABLE_MOMENTUM=1
HEAT_MOMENTUM_SCALE=2.0

# v2 pop/comment mode parameters
HEAT_POP_BASELINE=15
POP_GAMMA=1.6
P0=15
TOP_START=95
TOP_BOOST=0.35
BONUS_MAX=2.0
COMMENT_SHAPE=1.6
X0=3.477
X1=4.477
POP_TOP_START=95
POP_TOP_BOOST=0.35
COMMENT_REF=50000
COMMENT_GAMMA=1.15
POP_WEIGHT=0.60
CMT_WEIGHT=0.40
POP_COMMENT_G_START=85
POP_COMMENT_G_RANGE=15
WC_BASE=0.35
WC_BOOST=0.20
RAW_SCALE=8.0
HEAT_POP_POWER=1.25
HEAT_POP_WEIGHT=0.70
HEAT_COMMENT_WEIGHT=0.30
HEAT_COMMENT_SCALE_V2=8
HEAT_MOMENTUM_WEIGHT_MIN=0.25
HEAT_MOMENTUM_WEIGHT_MAX=0.75
HEAT_V2_RAW_SCALE=7.0
HEAT_NEW_SONG_FLOOR_RAW=3.5
HEAT_NEW_SONG_FLOOR_POP_MIN=35
HEAT_NEW_SONG_FLOOR_COMMENT_MIN=20
NEW_SONG_WINDOW_DAYS=180
HEAT_FRESH_HALFLIFE_DAYS=180

# 半年内 fresh_factor=1.0（新歌不衰减）
# 超过半年才开始衰减
# 想让新歌更猛：提高 HEAT_MOMENTUM_WEIGHT_MAX
# 想让衰减更慢：提高 HEAT_FRESH_HALFLIFE_DAYS（例如 240）
# 想让 pop 更有区分：提高 HEAT_POP_POWER（例如 1.35）
# 想让整体分布更“热”：提高 HEAT_V2_RAW_SCALE
HEAT_GATE_9_POP_MIN=98
HEAT_GATE_9_COMMENT_MIN=18000
HEAT_GATE_10_POP_MIN=100
HEAT_GATE_10_COMMENT_MIN=40000
